<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="format-detection" content="date=no,telephone=no">
    <title><%= h(product_name) %></title>
    <style type="text/css">
      body { margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; background-color: #f5f7fa; }
      table { border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      table td { border-collapse: collapse; }
      img { border: 0; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
      .container { width: 600px; max-width: 600px; }
      @media screen and (max-width: 599px) {
        .container { width: 100% !important; max-width: 100% !important; }
      }
      @media screen and (max-width: 400px) {
        .container-padding { padding-left: 20px !important; padding-right: 20px !important; }
      }
      a[href^="x-apple-data-detectors:"], a[x-apple-data-detectors] {
        color: inherit !important; text-decoration: none !important;
        font-size: inherit !important; font-family: inherit !important;
        font-weight: inherit !important; line-height: inherit !important;
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f5f7fa;" bgcolor="#f5f7fa">
    <table role="presentation" border="0" width="100%" height="100%" cellpadding="0" cellspacing="0" bgcolor="#f5f7fa">
      <tr>
        <td align="center" valign="top" style="padding: 24px 12px;">

          <!-- Card -->
          <table role="presentation" border="0" width="600" cellpadding="0" cellspacing="0" class="container" bgcolor="#ffffff" style="width: 600px; max-width: 600px; background-color: #ffffff; border: 1px solid #d5dce5; border-top: 3px solid <%= brand_color %>; border-radius: 10px;">
            <!-- Header / wordmark -->
            <tr>
              <td class="container-padding" align="left" style="padding: 28px 36px 0 36px;">
                <%# Render the logo only when the operator has opted in
                    (show_logo?) AND a usable absolute logo URL exists
                    (email_logo_url: brand.logo_url, else the brand pack's
                    brand-logo.png). show_logo? is a deliberate safety gate:
                    images can be blocked at the network or email-client level,
                    so a broken <img> is a negative trust signal. %>
                <% if show_logo? && email_logo_url %>
                  <% if wide_email_logo? %>
                <%# Co-brand (GoDatalize §2): horizontal logo, 1px divider, system name as text. %>
                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td valign="middle" style="padding: 0;">
                      <a href="<%= brand_baseuri %>" style="text-decoration: none;" rel="noopener noreferrer"><img alt="<%= h(logo_alt) %>" src="<%= email_logo_url %>" <%# herb:disable erb-prefer-image-tag-helper %>
                           style="border: 0; display: block; height: 28px; width: 160px;"
                           width="160" height="28"></a>
                    </td>
                    <td valign="middle" style="padding: 0 0 0 14px;">
                      <div style="width: 1px; height: 24px; background-color: #d5dce5; line-height: 24px; font-size: 1px;">&nbsp;</div>
                    </td>
                    <td valign="middle" style="padding: 0 0 0 14px; font-family: Sora, Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 17px; font-weight: 600; color: #556277;">
                      <%= h(product_name) %>
                    </td>
                  </tr>
                </table>
                  <% else %>
                <img alt="<%= h(logo_alt) %>" src="<%= email_logo_url %>" <%# herb:disable erb-prefer-image-tag-helper %>
                     style="border: 0; display: block; margin: 0 0 14px 0; height: 40px; width: 40px; background-color: <%= brand_color %>; border-radius: 8px;"
                     width="40" height="40">
                <a href="<%= brand_baseuri %>" style="text-decoration: none;" rel="noopener noreferrer"><span style="font-family: Sora, Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 17px; font-weight: 700; letter-spacing: -0.2px; color: <%= brand_color %>;"><%= h(product_name) %></span></a>
                  <% end %>
                <% else %>
                <a href="<%= brand_baseuri %>" style="text-decoration: none;" rel="noopener noreferrer"><span style="font-family: Sora, Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 17px; font-weight: 700; letter-spacing: -0.2px; color: <%= brand_color %>;"><%= h(product_name) %></span></a>
                <% end %>
                <div style="height: 1px; line-height: 1px; font-size: 1px; background-color: #e8edf4; margin: 22px 0 0 0;">&nbsp;</div>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td class="container-padding" align="left" style="padding: 24px 36px 30px 36px; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; color: #2b3442;">
                <%= content %>
              </td>
            </tr>
          </table>

          <!-- Sub-footer (outside card) -->
          <table role="presentation" border="0" width="600" cellpadding="0" cellspacing="0" class="container" style="width: 600px; max-width: 600px;">
            <tr>
              <td class="container-padding" align="center" style="padding: 18px 36px 8px 36px;">
                <p style="margin: 0; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #556277;">&nbsp;<a href="<%= brand_baseuri %>" style="color: <%= brand_color %>; text-decoration: none;" rel="noopener noreferrer"><%= h(brand_host) %></a>
                </p>
                <p style="margin: 6px 0 0 0; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 11px; line-height: 16px; color: #687489;">
                  <%= h(t('email.common.automated_notice', product_name: product_name)) %>
                </p>
                <% if support_email %>
                <p style="margin: 4px 0 0 0; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 11px; line-height: 16px; color: #687489;">
                  <a href="mailto:<%= h(support_email) %>" style="color: <%= brand_color %>; text-decoration: none;" rel="noopener noreferrer"><%= h(support_email) %></a>
                </p>
                <% end %>
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
  </body>
</html>

<%# Body content only. Shared shell, header, and footer come from layout.html.erb. -%>
<!-- Title -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 24px; color: #0a0e14; margin-bottom: 16px;">
  <p style="margin: 0;"><%= t('email.password_changed.title') %></p>
</div>

<!-- Body -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #2b3442;">
  <p><%= h(t('email.password_changed.body', product_name: product_name, date: changed_at_date, time: changed_at_time)) %></p>

  <p style="color: #7a2620; background-color: #fdecea; border-left: 3px solid #c0362c; padding: 12px 14px; border-radius: 4px; margin-top: 24px; font-size: 13px; line-height: 20px;">
    <%= t('email.password_changed.security_notice') %>
  </p>

  <p style="color: #556277; font-size: 12px; margin-top: 16px;">
    <a href="<%= baseuri %><%= security_settings_path %>" style="color: <%= brand_color %>;"><%= baseuri %><%= security_settings_path %></a>
  </p>
</div>

<!-- Signature -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #2b3442; margin-top: 32px; border-top: 1px solid #e8edf4; padding-top: 16px;">
  <p style="margin: 0;"><%= h(signature_name || t('email.password_changed.signature')) %></p>
</div>

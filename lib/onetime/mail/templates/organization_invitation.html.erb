<%# Body content only. Shared shell, header, and footer come from layout.html.erb. -%>
<!-- Title -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 24px; color: #0a0e14; margin-bottom: 16px;">
  <p style="margin: 0;"><%= h(t('email.organization_invitation.title', organization_name: organization_name)) %></p>
</div>

<!-- Body -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #2b3442;">
  <p><%= h(t('email.organization_invitation.body', inviter_email: inviter_email, organization_name: organization_name, role_description: role_description)) %></p>

  <div style="margin: 24px 0;">
    <a href="<%= baseuri %><%= invite_uri %>" style="display: inline-block; padding: 12px 24px; background-color: <%= brand_color %>; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 600;" rel="noopener noreferrer">
      <%= t('email.organization_invitation.accept_button') %>
    </a>
  </div>

  <p style="color: #556277; font-size: 12px;">
    <%= t('email.organization_invitation.link_instruction') %><br />
    <a href="<%= baseuri %><%= invite_uri %>" style="color: <%= brand_color %>; word-break: break-all;"><%= baseuri %><%= invite_uri %></a>
  </p>

  <p style="color: #556277; font-size: 13px; margin-top: 16px;">
    <%= t('email.organization_invitation.expiry_notice', days: expires_in_days) %>
  </p>

  <p style="color: #556277; font-size: 13px;">
    <%= t('email.organization_invitation.decline_instruction') %>
  </p>
</div>

<!-- Signature -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #2b3442; margin-top: 32px; border-top: 1px solid #e8edf4; padding-top: 16px;">
  <p style="margin: 0;"><%= h(signature_name || t('email.organization_invitation.signature')) %></p>
</div>

<!-- Postscript -->
<p style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; color: #687489; margin-top: 24px;">
  <%= h(t('email.organization_invitation.postscript', invited_email: invited_email)) %>
</p>

<%# Body content only. Shared shell, header, and footer come from layout.html.erb. -%>
<!-- Heading -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 22px; line-height: 30px; color: #0a0e14; margin: 0 0 18px 0;">
  <strong style="color: #0a0e14;"><%= h(custid) %></strong> <%= t('email.secret_link.sent_you_secret') %>
</div>

<!-- Primary action -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 0 22px 0;">
  <tr>
    <td bgcolor="<%= brand_color %>" style="background-color: <%= brand_color %>; border-radius: 10px;">
      <a href="<%= brand_baseuri %><%= uri_path %>" style="display: inline-block; padding: 13px 26px; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 600; line-height: 20px; color: #ffffff; text-decoration: none; border-radius: 10px;" rel="noopener noreferrer"><%= h(t('email.secret_link.view_button')) %></a>
    </td>
  </tr>
</table>

<!-- Secret link (the visible text is the exact destination) -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 20px 0;">
  <tr>
    <td bgcolor="#f5f7fa" style="background-color: #f5f7fa; border: 1px solid #d5dce5; border-radius: 8px; padding: 16px 18px;">
      <div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: #687489; margin: 0 0 8px 0;">
        <%= t('email.common.secret_link_label') %>
      </div>
      <a href="<%= brand_baseuri %><%= uri_path %>" style="display: block; text-decoration: none; word-break: break-all; font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; font-size: 14px; line-height: 22px;" rel="noopener noreferrer"><span style="color: <%= brand_color %>; font-weight: 700;"><%= h(brand_baseuri) %></span><span style="color: #7a879b;"><%= h(uri_path) %></span></a>
    </td>
  </tr>
</table>

<!-- Important: one-time use -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 16px 0;">
  <tr>
    <td bgcolor="#fff8eb" style="background-color: #fff8eb; border-left: 3px solid #b45309; border-radius: 4px; padding: 12px 14px; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 13px; line-height: 20px; color: #5c2a0c;">
      <strong style="color: #92400e;"><%= t('email.secret_link.important_label') %></strong> <%= t('email.secret_link.link_works_once') %>
    </td>
  </tr>
</table>

<% if has_passphrase %>
<!-- Passphrase required -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 16px 0;">
  <tr>
    <td bgcolor="#eef2fc" style="background-color: #eef2fc; border-left: 3px solid #3459c9; border-radius: 4px; padding: 12px 14px; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 13px; line-height: 20px; color: #1e3a8a;">
      <strong style="color: #3459c9;"><%= t('email.secret_link.passphrase_label') %></strong> <%= t('email.secret_link.passphrase_required') %>
    </td>
  </tr>
</table>
<% end %>

<!-- Why you received this -->
<p style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #687489; margin: 22px 0 0 0;">
  <%= h(t('email.secret_link.footer_note', sender_email: custid, product_name: product_name)) %>
</p>

<%# Body content only. Shared shell, header, and footer come from layout.html.erb. -%>
<!-- Title -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 24px; color: #0a0e14; margin-bottom: 16px;">
  <p style="margin: 0;"><%= t('email.email_change_confirmation.title') %></p>
</div>

<!-- Body -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #2b3442;">
  <p><%= h(t('email.email_change_confirmation.request_notice', product_name: product_name, new_email: new_email)) %></p>

  <div style="margin: 24px 0;">
    <a href="<%= confirmation_uri %>" style="display: inline-block; padding: 12px 24px; background-color: <%= brand_color %>; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 600;" rel="noopener noreferrer">
      <%= t('email.email_change_confirmation.confirm_button') %>
    </a>
  </div>

  <p style="color: #556277; font-size: 12px;">
    <%= t('email.email_change_confirmation.copy_link_prompt') %><br>
    <a href="<%= confirmation_uri %>" style="color: <%= brand_color %>; word-break: break-all;"><%= confirmation_uri %></a>
  </p>

  <p style="color: #556277; font-size: 12px;">
    <%= t('email.email_change_confirmation.expires_notice', hours: expires_in_hours) %>
  </p>

  <p style="color: #556277; background-color: #f5f7fa; padding: 12px; border-radius: 4px; margin-top: 24px;">
    <%= t('email.email_change_confirmation.ignore_notice') %>
  </p>
</div>

<!-- Signature -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #2b3442; margin-top: 32px; border-top: 1px solid #e8edf4; padding-top: 16px;">
  <p style="margin: 0;"><%= h(signature_name || t('email.email_change_confirmation.signature')) %></p>
</div>

<!-- Postscript -->
<p style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; color: #687489; margin-top: 24px;">
  <%= h(t('email.email_change_confirmation.postscript', email_address: new_email)) %>
</p>

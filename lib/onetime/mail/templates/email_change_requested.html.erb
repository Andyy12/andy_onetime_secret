<%# Body content only. Shared shell, header, and footer come from layout.html.erb. -%>
<!-- Title -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 24px; color: #0a0e14; margin-bottom: 16px;">
  <p style="margin: 0;"><%= t('email.email_change_requested.title') %></p>
</div>

<!-- Body -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #2b3442;">
  <p><%= t('email.email_change_requested.change_notice', product_name: product_name) %></p>

  <table border="0" cellpadding="0" cellspacing="0" style="margin: 16px 0; background-color: #f5f7fa; border-radius: 4px; width: 100%;">
    <tr>
      <td style="padding: 12px 16px; font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #2b3442;">
        <strong><%= t('email.email_change_requested.new_email_label') %></strong> <%= h(new_email) %><br />
        <strong><%= t('email.email_change_requested.requested_at_label') %></strong> <%= h(requested_at_formatted) %>
      </td>
    </tr>
  </table>

  <p><%= t('email.email_change_requested.if_you_initiated') %></p>

  <p style="color: #556277; background-color: #f5f7fa; padding: 12px; border-radius: 4px; margin-top: 24px;">
    <%= t('email.email_change_requested.not_you_notice') %>
    <a href="<%= baseuri %><%= support_path %>" style="color: <%= brand_color %>;"><%= t('email.email_change_requested.contact_support') %></a>
  </p>
</div>

<!-- Signature -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #2b3442; margin-top: 32px; border-top: 1px solid #e8edf4; padding-top: 16px;">
  <p style="margin: 0;"><%= h(signature_name || t('email.email_change_requested.signature')) %></p>
</div>

<!-- Postscript -->
<p style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; color: #687489; margin-top: 24px;">
  <%= h(t('email.email_change_requested.postscript', email_address: old_email)) %>
</p>

<%# Body content only. Shared shell, header, and footer come from layout.html.erb. -%>
<!-- Title -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 24px; color: #0a0e14; margin-bottom: 16px;">
  <p style="margin: 0;"><%= t('email.secret_revealed.title') %></p>
</div>

<!-- Body -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #2b3442;">
  <p><%= h(t('email.secret_revealed.viewed_on', date: revealed_at_formatted)) %></p>

  <div style="background-color: #f5f7fa; padding: 16px; border-radius: 4px; margin: 24px 0;">
    <p style="margin: 0; color: #556277; font-size: 12px;">
      <strong><%= t('email.secret_revealed.secret_id_label') %></strong> <%= h(secret_shortid) %>
    </p>
  </div>

  <p style="color: #556277;">
    <%= t('email.secret_revealed.automated_notice') %>
  </p>
</div>

<!-- Signature -->
<div style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #2b3442; margin-top: 32px; border-top: 1px solid #e8edf4; padding-top: 16px;">
  <p style="margin: 0;"><%= h(signature_name || t('email.secret_revealed.signature')) %></p>
</div>

<!-- Settings link -->
<p style="font-family: Inter, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; color: #687489; margin-top: 24px;">
  <a href="<%= baseuri %><%= settings_path %>" style="color: #687489;"><%= t('email.secret_revealed.manage_preferences') %></a>
</p>
